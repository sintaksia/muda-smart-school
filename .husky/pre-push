echo "🔍 Running guardrails (lint) before push..."

# Same command CI runs, so a green push means a green CI lint step.
if ! pnpm lint:ci 2>&1; then
  echo ""
  echo "❌ Guardrails failed! Push aborted."
  echo "Errors = design-system / architecture violations (docs/design_system.md)."
  echo "Too many warnings = you exceeded the --max-warnings ratchet in package.json."
  exit 1
fi

echo "🔨 Running build check before push..."

if ! pnpm build 2>&1; then
  echo ""
  echo "❌ Build failed! Push aborted."
  echo "Fix the build errors above before pushing."
  exit 1
fi

echo "✅ Guardrails and build passed. Pushing..."
