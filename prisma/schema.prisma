generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id
  email        String     @unique
  name         String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  avatar       String?
  phone        String?
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdById  String?    @map("created_by_id")
  createdBy    User?      @relation("CreatedByUser", fields: [createdById], references: [id])
  createdUsers User[]     @relation("CreatedByUser")
  student      Student?
  teacher      Teacher?

  notifications             Notification[]
  creditScoresReported      CreditScore[]       @relation("CreditReporter")
  leaveRequestsSubmitted    LeaveRequest[]      @relation("IzinSubmitter")
  leaveRequestsReviewed     LeaveRequest[]      @relation("IzinReviewer")
  teacherAttendanceReported TeacherAttendance[] @relation("TeacherAttendanceReporter")

  @@map("users")
}

model Registration {
  id                    String             @id @default(cuid())
  fullName              String             @map("full_name")
  gender                Gender             @map("gender")
  specialization        Specialization     @map("specialization")
  nisn                  String             @unique
  nik                   String             @unique
  familyCardNumber      String             @map("family_card_number")
  birthPlace            String             @map("birth_place")
  birthDate             DateTime           @map("birth_date")
  studentPhone          String             @map("student_phone")
  streetAddress         String             @map("street_address")
  rt                    String
  rw                    String
  village               String             @map("village")
  district              String
  city                  String             @map("city")
  province              String
  postalCode            String?            @map("postal_code")
  fatherName            String             @map("father_name")
  fatherBirthYear       Int                @map("father_birth_year")
  fatherEducation       Education          @map("father_education")
  fatherOccupation      String             @map("father_occupation")
  motherName            String             @map("mother_name")
  motherBirthYear       Int                @map("mother_birth_year")
  motherEducation       Education          @map("mother_education")
  motherOccupation      String             @map("mother_occupation")
  previousSchoolName    String             @map("previous_school_name")
  previousSchoolNpsn    String             @map("previous_school_npsn")
  previousSchoolAddress String             @map("previous_school_address")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  studentEmail          String?            @map("student_email")
  guardianRelationship  String?            @map("guardian_relationship")
  guardianName          String?            @map("guardian_name")
  fatherPhone           String?            @map("father_phone")
  motherPhone           String?            @map("mother_phone")
  guardianPhone         String?            @map("guardian_phone")
  registrationNumber    String             @unique @map("registration_number")
  guardianOccupation    String?            @map("guardian_occupation")
  guardianEducation     Education?         @map("guardian_education")
  guardianBirthYear     Int?               @map("guardian_birth_year")
  status                RegistrationStatus @default(PENDING)
  graduationYear        Int                @map("graduation_year")
  registrationDate      DateTime           @default(now()) @map("registration_date")
  student               Student?

  @@map("registrations")
}

model Student {
  id             String         @id @default(cuid())
  userId         String         @unique @map("user_id")
  registrationId String?        @unique @map("registration_id")
  nis            String         @unique
  nisn           String         @unique
  specialization Specialization @map("specialization")
  angkatan       Int
  classId        String?        @map("class_id")
  status         StudentStatus  @default(AKTIF)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user              User                @relation(fields: [userId], references: [id])
  registration      Registration?       @relation(fields: [registrationId], references: [id])
  schoolClass       SchoolClass?        @relation(fields: [classId], references: [id])
  studentAttendance StudentAttendance[]
  creditScores      CreditScore[]
  leaveRequests     LeaveRequest[]

  @@map("students")
}

model Teacher {
  id                String           @id @default(cuid())
  userId            String           @unique @map("user_id")
  nip               String?          @unique
  nuptk             String?          @unique
  gender            Gender           @map("gender")
  birthPlace        String           @map("birth_place")
  birthDate         DateTime         @map("birth_date")
  education         Education        @map("education")
  position          String?
  employmentStatus  EmploymentStatus @map("employment_status")
  teachingStartDate DateTime?        @map("teaching_start_date")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  user                        User                @relation(fields: [userId], references: [id])
  teacherSubjects             TeacherSubject[]
  homeroomClasses             SchoolClass[]
  schedules                   Schedule[]
  teacherAttendance           TeacherAttendance[]
  substituteTeacherAttendance TeacherAttendance[] @relation("SubstituteGuru")
  sessionsOpened              Session[]           @relation("SesiActualGuru")
  creditScores                CreditScore[]

  @@map("teachers")
}

model SchoolClass {
  id                String         @id @default(cuid())
  name              String
  gradeLevel        Int            @map("grade_level")
  specialization    Specialization @map("specialization")
  academicYear      String         @map("academic_year")
  homeroomTeacherId String?        @map("homeroom_teacher_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  homeroomTeacher Teacher?   @relation(fields: [homeroomTeacherId], references: [id])
  students        Student[]
  schedules       Schedule[]

  @@unique([name, academicYear])
  @@map("school_classes")
}

model Subject {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  specialization Specialization? @map("specialization")
  gradeLevel     Int?            @map("grade_level")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  teacherSubjects TeacherSubject[]
  schedules       Schedule[]

  @@map("subjects")
}

model TeacherSubject {
  id        String @id @default(cuid())
  teacherId String @map("teacher_id")
  subjectId String @map("subject_id")

  teacher Teacher @relation(fields: [teacherId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([teacherId, subjectId])
  @@map("teacher_subjects")
}

model Schedule {
  id           String    @id @default(cuid())
  classId      String    @map("class_id")
  subjectId    String    @map("subject_id")
  teacherId    String    @map("teacher_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startTime    String    @map("start_time")
  endTime      String    @map("end_time")
  academicYear String?   @map("academic_year")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  kelas             SchoolClass         @relation(fields: [classId], references: [id])
  mataPelajaran     Subject             @relation(fields: [subjectId], references: [id])
  guru              Teacher             @relation(fields: [teacherId], references: [id])
  studentAttendance StudentAttendance[]
  teacherAttendance TeacherAttendance[]
  sessions          Session[]
  leaveRequests     LeaveRequest[]

  @@map("schedules")
}

model Session {
  id              String        @id @default(cuid())
  scheduleId      String        @map("schedule_id")
  date            DateTime
  status          SessionStatus @default(OPEN)
  openedAt        DateTime?     @map("opened_at")
  closedAt        DateTime?     @map("closed_at")
  qrToken         String?       @unique @map("qr_token")
  qrTokenIssuedAt DateTime?     @map("qr_token_issued_at")
  actualTeacherId String?       @map("actual_teacher_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  jadwal            Schedule            @relation(fields: [scheduleId], references: [id])
  actualGuru        Teacher?            @relation("SesiActualGuru", fields: [actualTeacherId], references: [id])
  studentAttendance StudentAttendance[]
  creditScores      CreditScore[]
  leaveRequests     LeaveRequest[]

  @@unique([scheduleId, date])
  @@map("sessions")
}

model StudentAttendance {
  id          String           @id @default(cuid())
  scheduleId  String           @map("schedule_id")
  studentId   String           @map("student_id")
  sessionId   String?          @map("session_id")
  date        DateTime
  status      AttendanceStatus
  note        String?
  scanTime    DateTime?        @map("scan_time")
  gpsLat      Float?           @map("gps_lat")
  gpsLng      Float?           @map("gps_lng")
  gpsValid    Boolean?         @map("gps_valid")
  needsReview Boolean          @default(false) @map("needs_review")
  method      AttendanceMethod @default(MANUAL)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  jadwal  Schedule @relation(fields: [scheduleId], references: [id])
  student Student  @relation(fields: [studentId], references: [id])
  sesi    Session? @relation(fields: [sessionId], references: [id])

  @@unique([scheduleId, studentId, date])
  @@map("student_attendance")
}

model TeacherAttendance {
  id                  String           @id @default(cuid())
  scheduleId          String           @map("schedule_id")
  teacherId           String           @map("teacher_id")
  date                DateTime
  status              AttendanceStatus
  checkInTime         DateTime?        @map("check_in_time")
  note                String?
  reportedById        String?          @map("reported_by_id")
  substituteTeacherId String?          @map("substitute_teacher_id")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  jadwal         Schedule @relation(fields: [scheduleId], references: [id])
  guru           Teacher  @relation(fields: [teacherId], references: [id])
  reportedBy     User?    @relation("TeacherAttendanceReporter", fields: [reportedById], references: [id])
  substituteGuru Teacher? @relation("SubstituteGuru", fields: [substituteTeacherId], references: [id])

  @@unique([scheduleId, teacherId, date])
  @@map("teacher_attendance")
}

model CreditScore {
  id           String          @id @default(cuid())
  ownerType    CreditOwnerType @map("owner_type")
  studentId    String?         @map("student_id")
  teacherId    String?         @map("teacher_id")
  type         CreditEntryType
  category     String
  points       Int
  note         String?
  evidence     String?
  source       CreditSource
  refSessionId String?         @map("ref_session_id")
  reportedById String?         @map("reported_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  student    Student? @relation(fields: [studentId], references: [id])
  guru       Teacher? @relation(fields: [teacherId], references: [id])
  refSesi    Session? @relation(fields: [refSessionId], references: [id])
  reportedBy User?    @relation("CreditReporter", fields: [reportedById], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([refSessionId])
  @@map("credit_scores")
}

model CreditCategory {
  id            String          @id @default(cuid())
  ownerType     CreditOwnerType @map("owner_type")
  type          CreditEntryType
  name          String
  defaultPoints Int             @default(0) @map("default_points")
  order         Int             @default(0)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([ownerType, type, name])
  @@map("credit_categories")
}

model LeaveRequest {
  id            String      @id @default(cuid())
  studentId     String      @map("student_id")
  type          LeaveType
  date          DateTime
  scheduleId    String?     @map("schedule_id")
  sessionId     String?     @map("session_id")
  reason        String
  attachment    String?
  status        LeaveStatus @default(PENDING)
  submittedById String?     @map("submitted_by_id")
  reviewedById  String?     @map("reviewed_by_id")
  reviewedAt    DateTime?   @map("reviewed_at")
  reviewNote    String?     @map("review_note")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  student     Student   @relation(fields: [studentId], references: [id])
  jadwal      Schedule? @relation(fields: [scheduleId], references: [id])
  sesi        Session?  @relation(fields: [sessionId], references: [id])
  submittedBy User?     @relation("IzinSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?     @relation("IzinReviewer", fields: [reviewedById], references: [id])

  @@index([studentId, date])
  @@map("leave_requests")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType
  refId     String?          @map("ref_id")
  channel   String           @default("IN_APP")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaText   String?  @map("cta_text")
  ctaLink   String?  @map("cta_link")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_slides")
}

model Program {
  id           String            @id @default(cuid())
  name         String
  abbreviation String
  description  String
  color        String
  image        String?
  order        Int               @default(0)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  careers      ProgramCareer[]
  facilities   ProgramFacility[]
  skills       ProgramSkill[]

  @@map("programs")
}

model ProgramSkill {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_skills")
}

model ProgramCareer {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_careers")
}

model ProgramFacility {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_facilities")
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  image       String?
  category    String
  isFeatured  Boolean   @default(false) @map("is_featured")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("news")
}

model Testimonial {
  id        String          @id @default(cuid())
  name      String
  role      String
  quote     String
  type      TestimonialType
  image     String?
  order     Int             @default(0)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Achievement {
  id          String           @id @default(cuid())
  title       String
  event       String
  level       AchievementLevel
  medalType   MedalType?       @map("medal_type")
  year        Int
  image       String?
  order       Int              @default(0)
  isHighlight Boolean          @default(false) @map("is_highlight")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("achievements")
}

model Gallery {
  id          String          @id @default(cuid())
  title       String
  description String?
  image       String
  category    GalleryCategory
  order       Int             @default(0)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("gallery")
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  images      String[] @default([])
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("facilities")
}

model Extracurricular {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    EkskulCategory
  icon        String?
  image       String?
  order       Int            @default(0)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("extracurriculars")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model Contact {
  id          String      @id @default(cuid())
  name        String
  value       String
  type        ContactType
  description String?
  order       Int         @default(0)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("contacts")
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  username  String?
  order     Int            @default(0)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("social_links")
}

model AiChatSetting {
  id             String   @id @default(cuid())
  systemPrompt   String   @map("system_prompt")
  welcomeMessage String   @default("Halo! Saya asisten virtual SMK Muhammadiyah 2 Cibiru. Ada yang bisa saya bantu? 😊") @map("welcome_message")
  suggestions    String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_chat_settings")
}

model SchoolSetting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      SettingType @default(TEXT)
  label     String
  group     String      @default("general")
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("school_settings")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum Specialization {
  AUTOMOTIVE_ENGINEERING
  SOFTWARE_AND_GAME_DEVELOPMENT
  NETWORK_AND_TELECOMMUNICATIONS_ENGINEERING
  OFFICE_MANAGEMENT_AND_BUSINESS_SERVICES
  ACCOUNTING_AND_INSTITUTIONAL_FINANCE
}

enum Education {
  SD
  SMP
  SMA
  SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
  NO_SCHOOLING
}

enum TestimonialType {
  ALUMNI
  PARENT
  TEACHER
  PARTNER
}

enum MedalType {
  GOLD
  SILVER
  BRONZE
  FIRST_PLACE
  SECOND_PLACE
  THIRD_PLACE
  HONORABLE_MENTION_1
  HONORABLE_MENTION_2
  HONORABLE_MENTION_3
}

enum AchievementLevel {
  INTERNATIONAL
  NATIONAL
  PROVINCE
  CITY
  DISTRICT
  SCHOOL
}

enum GalleryCategory {
  FACILITIES
  ACTIVITIES
  ACHIEVEMENTS
  EXTRACURRICULAR
  OTHER
}

enum EkskulCategory {
  ORGANIZATION
  SCOUTING
  MARTIAL_ARTS
  SPORTS
  ARTS
  ACADEMIC
  RELIGIOUS
  OTHER
}

enum ContactType {
  WHATSAPP
  PHONE
  EMAIL
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TWITTER
  TIKTOK
  LINKEDIN
  WEBSITE
}

enum SettingType {
  TEXT
  TEXTAREA
  HTML
  JSON
  IMAGE
  NUMBER
  BOOLEAN
}

enum RegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
  ACCEPTED
}

enum StudentStatus {
  AKTIF
  LULUS
  PINDAH
  DROPOUT
}

enum EmploymentStatus {
  PNS
  PPPK
  GTY
  GTT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum AttendanceStatus {
  PRESENT
  LATE
  SICK
  EXCUSED
  ABSENT
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum SessionStatus {
  OPEN
  CLOSED
  NO_CLASS
}

enum CreditOwnerType {
  STUDENT
  TEACHER
}

enum CreditEntryType {
  ACHIEVEMENT
  VIOLATION
  CORRECTION
}

enum CreditSource {
  AUTO
  MANUAL
}

enum LeaveType {
  PERMISSION
  SICK
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CREDIT_WARNING
  CREDIT_CRITICAL
  CREDIT_MANUAL_ENTRY
  GPS_REVIEW
  TEACHER_ABSENCE
  NO_CLASS
  LEAVE_STATUS
}
