generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id
  email        String     @unique
  name         String
  role         UserRole   @default(STUDENT)
  status       UserStatus @default(ACTIVE)
  avatar       String?
  phone        String?
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  createdById  String?    @map("created_by_id")
  createdBy    User?      @relation("CreatedByUser", fields: [createdById], references: [id])
  createdUsers User[]     @relation("CreatedByUser")
  student      Student?
  guru         Guru?

  notifications        Notification[]
  creditScoresReported CreditScore[]   @relation("CreditReporter")
  izinSubmitted        PengajuanIzin[] @relation("IzinSubmitter")
  izinReviewed         PengajuanIzin[] @relation("IzinReviewer")
  absensiGuruReported  AbsensiGuru[]   @relation("AbsensiGuruReporter")

  @@map("users")
}

model Registration {
  id                    String             @id @default(cuid())
  fullName              String             @map("full_name")
  gender                Gender             @map("gender")
  specialization        Specialization     @map("specialization")
  nisn                  String             @unique
  nik                   String             @unique
  familyCardNumber      String             @map("family_card_number")
  birthPlace            String             @map("birth_place")
  birthDate             DateTime           @map("birth_date")
  studentPhone          String             @map("student_phone")
  streetAddress         String             @map("street_address")
  rt                    String
  rw                    String
  village               String             @map("village")
  district              String
  city                  String             @map("city")
  province              String
  postalCode            String?            @map("postal_code")
  fatherName            String             @map("father_name")
  fatherBirthYear       Int                @map("father_birth_year")
  fatherEducation       Education          @map("father_education")
  fatherOccupation      String             @map("father_occupation")
  motherName            String             @map("mother_name")
  motherBirthYear       Int                @map("mother_birth_year")
  motherEducation       Education          @map("mother_education")
  motherOccupation      String             @map("mother_occupation")
  previousSchoolName    String             @map("previous_school_name")
  previousSchoolNpsn    String             @map("previous_school_npsn")
  previousSchoolAddress String             @map("previous_school_address")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  studentEmail          String?            @map("student_email")
  guardianRelationship  String?            @map("guardian_relationship")
  guardianName          String?            @map("guardian_name")
  fatherPhone           String?            @map("father_phone")
  motherPhone           String?            @map("mother_phone")
  guardianPhone         String?            @map("guardian_phone")
  registrationNumber    String             @unique @map("registration_number")
  guardianOccupation    String?            @map("guardian_occupation")
  guardianEducation     Education?         @map("guardian_education")
  guardianBirthYear     Int?               @map("guardian_birth_year")
  status                RegistrationStatus @default(PENDING)
  graduationYear        Int                @map("graduation_year")
  registrationDate      DateTime           @default(now()) @map("registration_date")
  student               Student?

  @@map("registrations")
}

model Student {
  id             String         @id @default(cuid())
  userId         String         @unique @map("user_id")
  registrationId String?        @unique @map("registration_id")
  nis            String         @unique
  nisn           String         @unique
  specialization Specialization @map("specialization")
  angkatan       Int
  kelasId        String?        @map("kelas_id")
  status         StudentStatus  @default(AKTIF)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user          User            @relation(fields: [userId], references: [id])
  registration  Registration?   @relation(fields: [registrationId], references: [id])
  kelas         Kelas?          @relation(fields: [kelasId], references: [id])
  absensiSiswa  AbsensiSiswa[]
  creditScores  CreditScore[]
  pengajuanIzin PengajuanIzin[]

  @@map("students")
}

model Guru {
  id                   String            @id @default(cuid())
  userId               String            @unique @map("user_id")
  nip                  String?           @unique
  nuptk                String?           @unique
  gender               Gender            @map("gender")
  tempatLahir          String            @map("tempat_lahir")
  tanggalLahir         DateTime          @map("tanggal_lahir")
  education            Education         @map("education")
  jabatan              String?
  statusKepegawaian    StatusKepegawaian @map("status_kepegawaian")
  tanggalMulaiMengajar DateTime?         @map("tanggal_mulai_mengajar")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  user                 User                @relation(fields: [userId], references: [id])
  mataPelajaran        GuruMataPelajaran[]
  kelasWali            Kelas[]
  jadwal               Jadwal[]
  absensiGuru          AbsensiGuru[]
  absensiGuruPengganti AbsensiGuru[]       @relation("SubstituteGuru")
  sesiDibuka           Sesi[]              @relation("SesiActualGuru")
  creditScores         CreditScore[]

  @@map("guru")
}

model Kelas {
  id             String         @id @default(cuid())
  nama           String
  tingkat        Int
  specialization Specialization @map("specialization")
  tahunAjaran    String         @map("tahun_ajaran")
  waliKelasId    String?        @map("wali_kelas_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  waliKelas Guru?     @relation(fields: [waliKelasId], references: [id])
  students  Student[]
  jadwal    Jadwal[]

  @@unique([nama, tahunAjaran])
  @@map("kelas")
}

model MataPelajaran {
  id             String          @id @default(cuid())
  nama           String
  kode           String          @unique
  specialization Specialization? @map("specialization")
  tingkat        Int?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  guru   GuruMataPelajaran[]
  jadwal Jadwal[]

  @@map("mata_pelajaran")
}

model GuruMataPelajaran {
  id              String @id @default(cuid())
  guruId          String @map("guru_id")
  mataPelajaranId String @map("mata_pelajaran_id")

  guru          Guru          @relation(fields: [guruId], references: [id])
  mataPelajaran MataPelajaran @relation(fields: [mataPelajaranId], references: [id])

  @@unique([guruId, mataPelajaranId])
  @@map("guru_mata_pelajaran")
}

model Jadwal {
  id              String   @id @default(cuid())
  kelasId         String   @map("kelas_id")
  mataPelajaranId String   @map("mata_pelajaran_id")
  guruId          String   @map("guru_id")
  hari            HariEnum
  jamMulai        String   @map("jam_mulai")
  jamSelesai      String   @map("jam_selesai")
  tahunAjaran     String?  @map("tahun_ajaran")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  kelas         Kelas           @relation(fields: [kelasId], references: [id])
  mataPelajaran MataPelajaran   @relation(fields: [mataPelajaranId], references: [id])
  guru          Guru            @relation(fields: [guruId], references: [id])
  absensiSiswa  AbsensiSiswa[]
  absensiGuru   AbsensiGuru[]
  sesi          Sesi[]
  pengajuanIzin PengajuanIzin[]

  @@map("jadwal")
}

model Sesi {
  id              String     @id @default(cuid())
  jadwalId        String     @map("jadwal_id")
  tanggal         DateTime
  status          SesiStatus @default(OPEN)
  openedAt        DateTime?  @map("opened_at")
  closedAt        DateTime?  @map("closed_at")
  qrToken         String?    @unique @map("qr_token")
  qrTokenIssuedAt DateTime?  @map("qr_token_issued_at")
  actualGuruId    String?    @map("actual_guru_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  jadwal        Jadwal          @relation(fields: [jadwalId], references: [id])
  actualGuru    Guru?           @relation("SesiActualGuru", fields: [actualGuruId], references: [id])
  absensiSiswa  AbsensiSiswa[]
  creditScores  CreditScore[]
  pengajuanIzin PengajuanIzin[]

  @@unique([jadwalId, tanggal])
  @@map("sesi")
}

model AbsensiSiswa {
  id          String        @id @default(cuid())
  jadwalId    String        @map("jadwal_id")
  studentId   String        @map("student_id")
  sesiId      String?       @map("sesi_id")
  tanggal     DateTime
  status      AbsensiStatus
  catatan     String?
  scanTime    DateTime?     @map("scan_time")
  gpsLat      Float?        @map("gps_lat")
  gpsLng      Float?        @map("gps_lng")
  gpsValid    Boolean?      @map("gps_valid")
  needsReview Boolean       @default(false) @map("needs_review")
  method      AbsensiMethod @default(MANUAL)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  jadwal  Jadwal  @relation(fields: [jadwalId], references: [id])
  student Student @relation(fields: [studentId], references: [id])
  sesi    Sesi?   @relation(fields: [sesiId], references: [id])

  @@unique([jadwalId, studentId, tanggal])
  @@map("absensi_siswa")
}

model AbsensiGuru {
  id               String        @id @default(cuid())
  jadwalId         String        @map("jadwal_id")
  guruId           String        @map("guru_id")
  tanggal          DateTime
  status           AbsensiStatus
  jamMasuk         DateTime?     @map("jam_masuk")
  catatan          String?
  reportedById     String?       @map("reported_by_id")
  substituteGuruId String?       @map("substitute_guru_id")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  jadwal         Jadwal @relation(fields: [jadwalId], references: [id])
  guru           Guru   @relation(fields: [guruId], references: [id])
  reportedBy     User?  @relation("AbsensiGuruReporter", fields: [reportedById], references: [id])
  substituteGuru Guru?  @relation("SubstituteGuru", fields: [substituteGuruId], references: [id])

  @@unique([jadwalId, guruId, tanggal])
  @@map("absensi_guru")
}

model CreditScore {
  id           String          @id @default(cuid())
  ownerType    CreditOwnerType @map("owner_type")
  studentId    String?         @map("student_id")
  guruId       String?         @map("guru_id")
  type         CreditEntryType
  category     String
  points       Int
  note         String?
  evidence     String?
  source       CreditSource
  refSesiId    String?         @map("ref_sesi_id")
  reportedById String?         @map("reported_by_id")
  createdAt    DateTime        @default(now()) @map("created_at")

  student    Student? @relation(fields: [studentId], references: [id])
  guru       Guru?    @relation(fields: [guruId], references: [id])
  refSesi    Sesi?    @relation(fields: [refSesiId], references: [id])
  reportedBy User?    @relation("CreditReporter", fields: [reportedById], references: [id])

  @@index([studentId])
  @@index([guruId])
  @@index([refSesiId])
  @@map("credit_scores")
}

model CreditCategory {
  id            String          @id @default(cuid())
  ownerType     CreditOwnerType @map("owner_type")
  type          CreditEntryType
  nama          String
  defaultPoints Int             @default(0) @map("default_points")
  order         Int             @default(0)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([ownerType, type, nama])
  @@map("credit_categories")
}

model PengajuanIzin {
  id            String     @id @default(cuid())
  studentId     String     @map("student_id")
  jenis         IzinJenis
  tanggal       DateTime
  jadwalId      String?    @map("jadwal_id")
  sesiId        String?    @map("sesi_id")
  alasan        String
  lampiran      String?
  status        IzinStatus @default(PENDING)
  submittedById String?    @map("submitted_by_id")
  reviewedById  String?    @map("reviewed_by_id")
  reviewedAt    DateTime?  @map("reviewed_at")
  reviewNote    String?    @map("review_note")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  student     Student @relation(fields: [studentId], references: [id])
  jadwal      Jadwal? @relation(fields: [jadwalId], references: [id])
  sesi        Sesi?   @relation(fields: [sesiId], references: [id])
  submittedBy User?   @relation("IzinSubmitter", fields: [submittedById], references: [id])
  reviewedBy  User?   @relation("IzinReviewer", fields: [reviewedById], references: [id])

  @@index([studentId, tanggal])
  @@map("pengajuan_izin")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  body      String
  type      NotificationType
  refId     String?          @map("ref_id")
  channel   String           @default("IN_APP")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String
  ctaText   String?  @map("cta_text")
  ctaLink   String?  @map("cta_link")
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("hero_slides")
}

model Program {
  id           String            @id @default(cuid())
  name         String
  abbreviation String
  description  String
  color        String
  image        String?
  order        Int               @default(0)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  careers      ProgramCareer[]
  facilities   ProgramFacility[]
  skills       ProgramSkill[]

  @@map("programs")
}

model ProgramSkill {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_skills")
}

model ProgramCareer {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_careers")
}

model ProgramFacility {
  id        String   @id @default(cuid())
  programId String   @map("program_id")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_facilities")
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  image       String?
  category    String
  isFeatured  Boolean   @default(false) @map("is_featured")
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("news")
}

model Testimonial {
  id        String          @id @default(cuid())
  name      String
  role      String
  quote     String
  type      TestimonialType
  image     String?
  order     Int             @default(0)
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Achievement {
  id          String           @id @default(cuid())
  title       String
  event       String
  level       AchievementLevel
  medalType   MedalType?       @map("medal_type")
  year        Int
  image       String?
  order       Int              @default(0)
  isHighlight Boolean          @default(false) @map("is_highlight")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@map("achievements")
}

model Gallery {
  id          String          @id @default(cuid())
  title       String
  description String?
  image       String
  category    GalleryCategory
  order       Int             @default(0)
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@map("gallery")
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  images      String[] @default([])
  order       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("facilities")
}

model Extracurricular {
  id          String         @id @default(cuid())
  name        String
  description String?
  category    EkskulCategory
  icon        String?
  image       String?
  order       Int            @default(0)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@map("extracurriculars")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model Contact {
  id          String      @id @default(cuid())
  name        String
  value       String
  type        ContactType
  description String?
  order       Int         @default(0)
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("contacts")
}

model SocialLink {
  id        String         @id @default(cuid())
  platform  SocialPlatform
  url       String
  username  String?
  order     Int            @default(0)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("social_links")
}

model AiChatSetting {
  id             String   @id @default(cuid())
  systemPrompt   String   @map("system_prompt")
  welcomeMessage String   @default("Halo! Saya asisten virtual SMK Muhammadiyah 2 Cibiru. Ada yang bisa saya bantu? 😊") @map("welcome_message")
  suggestions    String[] @default([])
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("ai_chat_settings")
}

model SchoolSetting {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      SettingType @default(TEXT)
  label     String
  group     String      @default("general")
  order     Int         @default(0)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("school_settings")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
}

enum Specialization {
  AUTOMOTIVE_ENGINEERING
  SOFTWARE_AND_GAME_DEVELOPMENT
  NETWORK_AND_TELECOMMUNICATIONS_ENGINEERING
  OFFICE_MANAGEMENT_AND_BUSINESS_SERVICES
  ACCOUNTING_AND_INSTITUTIONAL_FINANCE
}

enum Education {
  SD
  SMP
  SMA
  SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
  NO_SCHOOLING
}

enum TestimonialType {
  ALUMNI
  ORANG_TUA
  GURU
  MITRA
}

enum MedalType {
  GOLD
  SILVER
  BRONZE
  JUARA_1
  JUARA_2
  JUARA_3
  HARAPAN_1
  HARAPAN_2
  HARAPAN_3
}

enum AchievementLevel {
  INTERNASIONAL
  NASIONAL
  PROVINSI
  KOTA
  KECAMATAN
  SEKOLAH
}

enum GalleryCategory {
  FASILITAS
  KEGIATAN
  PRESTASI
  EKSKUL
  LAINNYA
}

enum EkskulCategory {
  ORGANISASI
  KEPANDUAN
  BELADIRI
  OLAHRAGA
  SENI
  AKADEMIK
  KEAGAMAAN
  LAINNYA
}

enum ContactType {
  WHATSAPP
  PHONE
  EMAIL
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
  YOUTUBE
  TWITTER
  TIKTOK
  LINKEDIN
  WEBSITE
}

enum SettingType {
  TEXT
  TEXTAREA
  HTML
  JSON
  IMAGE
  NUMBER
  BOOLEAN
}

enum RegistrationStatus {
  PENDING
  VERIFIED
  REJECTED
  ACCEPTED
}

enum StudentStatus {
  AKTIF
  LULUS
  PINDAH
  DROPOUT
}

enum StatusKepegawaian {
  PNS
  PPPK
  GTY
  GTT
}

enum HariEnum {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

enum AbsensiStatus {
  HADIR
  TERLAMBAT
  SAKIT
  IZIN
  ALPHA
}

enum AbsensiMethod {
  QR
  MANUAL
}

enum SesiStatus {
  OPEN
  CLOSED
  KELAS_KOSONG
}

enum CreditOwnerType {
  STUDENT
  TEACHER
}

enum CreditEntryType {
  PRESTASI
  PELANGGARAN
  KOREKSI
}

enum CreditSource {
  AUTO
  MANUAL
}

enum IzinJenis {
  IZIN
  SAKIT
}

enum IzinStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  CREDIT_WARNING
  CREDIT_CRITICAL
  CREDIT_MANUAL_ENTRY
  GPS_REVIEW
  TEACHER_ABSENCE
  KELAS_KOSONG
  IZIN_STATUS
}
